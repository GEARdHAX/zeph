# ============================================================
# zeph. Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on
PORT=4002

# Pino log level: trace | debug | info | warn | error | fatal
# Pretty-printed locally; set NODE_ENV=production for raw JSON logs (log aggregator-friendly).
LOG_LEVEL=info

# ── Mediasoup / WebRTC ───────────────────────────────────────
# Set to 'true' ONLY on servers with native build tools (gcc, python3, make):
#   - Local Docker (uses the Dockerfile which installs build tools)
#   - A real VPS with docker or a native Node install
# Set to 'false' or leave unset on:
#   - Glitch.com (shared host, no native build tools)
#   - Any PaaS that can't compile C++ addons
# When false: Express + Socket.IO + chat work fully. Video/audio calls are disabled.
MEDIASOUP_ENABLED=true

# ── WebRTC / Mediasoup ───────────────────────────────────────
# The public IP address of this server, used for Mediasoup ICE candidates.
# For local dev: your LAN IP (e.g. 192.168.1.x), NOT 127.0.0.1
# For production: your server's public IPv4
PUBLIC_IP_ADDRESS=127.0.0.1

# Set to true if running behind NAT (AWS, GCP, Azure).
# Set to false for bare-metal VPS (Hetzner, DigitalOcean, Oracle bare).
MAPPED_IP=false

# ── Authentication ───────────────────────────────────────────
# Secret key used to sign JWTs. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED — the server refuses to start if this is unset (no insecure default).
AUTH_SECRET="change-me-to-a-random-secret"

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local Docker dev: http://localhost:5173
# Production: your deployed frontend origin(s), e.g. https://chitcx.pages.dev
CORS_ORIGIN=http://localhost:5173

# ── Trust Proxy (client IP resolution) ───────────────────────
# Number of reverse-proxy hops in front of this Node process to trust when
# resolving the real client IP from X-Forwarded-For (Express's own
# app.set('trust proxy', N) semantics — see init.js). Production sits behind
# exactly one hop (Cloudflare -> Fly.io's edge -> this process), so 1 is
# correct there. A HIGHER value than the real hop count lets a client forge
# their own IP by chaining fake X-Forwarded-For entries — never set this
# higher than the actual number of proxies you control.
TRUST_PROXY_HOPS=1

# ── Root / Admin User ────────────────────────────────────────
# Created (or updated) on every backend startup. Change before first deploy.
ROOT_USER_USERNAME=admin
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=change-me
ROOT_USER_FIRST_NAME=Admin
ROOT_USER_LAST_NAME=User

# ── MongoDB ──────────────────────────────────────────────────
# Option A: full URI (recommended — takes priority over connection details below)
# Local Docker:  mongodb://mongo:27017/chitcx
# Atlas:         mongodb+srv://user:pass@cluster.mongodb.net/chitcx
MONGO_URI=mongodb://localhost:27017/chitcx

# Option B: individual connection parameters (used only when MONGO_URI is blank)
MONGO_SRV=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTHENTICATION_DATABASE=admin
MONGO_HOSTNAME=
MONGO_PORT=27017
MONGO_DATABASE=chitcx

# ── Redis ────────────────────────────────────────────────────
# Local Docker:  redis://redis:6379
# Upstash:       rediss://default:TOKEN@HOST.upstash.io:PORT (note the rediss://
#                double-s scheme — TLS required; port varies by Upstash plan/region)
# Leave unset to run Socket.IO in single-process mode (see setupRedisAdapter.js) —
# the app works completely without this, same as today. Set it to enable
# multi-instance Socket.IO delivery (every `store.io.to(userId).emit(...)`
# resolves correctly across processes, not just within one).
REDIS_URL=redis://localhost:6379

# ── Email / Mailer ───────────────────────────────────────────
# Set MAILER_ENABLED=true to activate the email queue cron job
MAILER_ENABLED=false
MAILER_FROM="zeph. <no-reply@yourdomain.tld>"
MAILER_USERNAME=no-reply@yourdomain.tld
MAILER_PASSWORD=
# MAILER_SERVICE: named service (e.g. hotmail, gmail) — leave blank if using SMTP below
MAILER_SERVICE=
# MAILER_HOST: SMTP host — leave blank if using MAILER_SERVICE above
# Any SMTP relay works here (Brevo, Mailgun, your own server, etc.) — e.g.
# for Brevo: MAILER_HOST=smtp-relay.brevo.com, MAILER_PORT=587,
# MAILER_USERNAME=<Brevo SMTP login>, MAILER_PASSWORD=<Brevo SMTP key>.
MAILER_HOST=smtp.yourdomain.tld
MAILER_PORT=587
# true = require STARTTLS
MAILER_SECURE=false
# Support email shown to users in the app
SUPPORT_EMAIL_ADDRESS=support@example.com

# ── Object Storage (optional — Cloudflare R2 for media uploads) ────
# Leave all four blank to use local-disk storage (./data, same as today) —
# the app works completely without this section. Set all four to switch
# new media uploads (images/video/audio/pdf/documents/archives sent via the
# chat's attach-file flow) onto R2 object storage instead. See
# infra/cloudflare.md for how to provision the bucket + credentials.
# R2 is S3-protocol-compatible — @aws-sdk/client-s3 talks to it via ENDPOINT,
# no AWS account or AWS-hosted storage involved.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Zeph AI (optional — summarize / translate / rewrite / draft-reply / title / topics) ──
# Leave AI_PROVIDER unset (or 'none') to run with AI features fully disabled —
# the app works completely without this section; every /api/ai/* route
# returns 503 and no other Zeph functionality depends on this.
#
# Set to 'groq' (recommended, default target) to use Groq's free-tier cloud
# API with Llama 3.1 8B Instant — get a free key at https://console.groq.com.
# GROQ_API_KEY is server-side only; it is NEVER sent to the frontend.
#
# Set to 'ollama' instead to use a local, self-hosted model
# (docker compose --profile ai up) — no cloud API key needed for that path.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Token/context budget (see backend/src/ai/contextBuilder.js) — never send
# unbounded conversation history to the model.
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=800
AI_PROVIDER_TIMEOUT_MS=15000

# Quota / Abuse Protection (see backend/src/ai/quota.js) — Zeph's OWN
# self-imposed ceilings, deliberately stricter than Groq's actual free-tier
# limits. Requires REDIS_URL above to be set; without Redis these are
# unenforced (the express-rate-limit AI limiter in init.js is the fallback
# per-IP guard in that case).
AI_LIMIT_USER_PER_MINUTE=5
AI_LIMIT_USER_PER_DAY=50
AI_LIMIT_USER_CONCURRENT=2
AI_LIMIT_IP_PER_MINUTE=20
AI_LIMIT_GLOBAL_CONCURRENT=10

# Eligibility Engine thresholds (see backend/src/ai/policy.js) — minimum
# conversation size before Zeph will generate each AI feature.
AI_POLICY_GROUP_SUMMARY_MIN_MESSAGES=100
AI_POLICY_DM_SUMMARY_MIN_MESSAGES=30
AI_POLICY_TITLE_MIN_MESSAGES=5
AI_POLICY_TOPIC_MIN_MESSAGES=50
AI_POLICY_SUMMARY_FRESHNESS_MIN_NEW_MESSAGES=25

# Meeting AI (see backend/src/ai/meetingTranscriptService.js) — requires
# AI_PROVIDER=groq specifically (transcription uses Groq's Whisper endpoint;
# Ollama has no bundled speech-to-text integration in this codebase).
AI_POLICY_MEETING_SUMMARY_MIN_DURATION_SECONDS=300
AI_POLICY_MEETING_SUMMARY_MIN_PARTICIPANTS=2
AI_POLICY_MEETING_SUMMARY_MIN_TRANSCRIPT_WORDS=100

# ── AI Security Risk Engine (Phase 6, optional) ──────────────────────
# Separate flag from AI_PROVIDER above — the chat-assistant features and
# security analysis are different privacy/risk surfaces an operator may
# want to enable independently, even though both call the same provider.
# Leave AI_SECURITY_ENABLED unset (or 'false') to run with AI security
# analysis fully disabled — Security Telemetry/Threat Intel/eBPF/Network
# Intelligence/Risk Engine/Zero Trust all continue to work unaffected;
# only AI-specific analysis/incident correlation disappears.
AI_SECURITY_ENABLED=false
# Optional larger model for complex multi-signal correlation — unset by
# default (every analysis routes to OLLAMA_MODEL above; see
# services/securityAi/modelRouter.js's own honest note that ZEPH does not
# ship a real "1B -> 7B" pipeline out of the box, this is what enables one).
AI_SECURITY_LARGE_MODEL=
SECURITY_AI_TIMEOUT_MS=8000
SECURITY_AI_CACHE_TTL_SECONDS=60
SECURITY_AI_MIN_SIGNAL_CATEGORIES=1

# ── Threat Intelligence (optional — AbuseIPDB IP reputation) ────────
# Leave ABUSEIPDB_ENABLED=false (or unset) to run fully disabled — the app
# works completely without this section (Zero Trust risk scoring just never
# gets a threat-intel signal, same as if every lookup came back UNKNOWN).
# Get a free key at https://www.abuseipdb.com/account/api (Standard tier:
# 1000 checks/day on the account itself — ABUSEIPDB_DAILY_BUDGET below is
# ZEPH's OWN lower internal budget, not that account limit).
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com
ABUSEIPDB_TIMEOUT_MS=5000
ABUSEIPDB_DAILY_BUDGET=800
# How long a normalized threat-intel result stays cached in Redis before a
# repeat lookup re-checks the provider (spec section 5/26 — reputation
# changes over time, never cache indefinitely).
THREAT_INTEL_CACHE_TTL_SECONDS=21600

# ── eBPF Runtime Security Sensor (optional, backend side) ───────────────
# The backend needs NO new env vars to accept sensor traffic — sensor
# identity/credentials live in Mongo (SensorCredential documents, minted via
# POST /api/security/sensor/register), and rate-limit thresholds are
# hardcoded in routes/index.js's sensorEventsLimit (raise there if a real
# fleet size needs it). This section exists purely to document the
# separate, independently-deployed sensor process's OWN config — it reads
# these from ITS OWN environment (see ebpf-sensor/ once that process
# exists), the main ZEPH backend never touches them.
#
# Requires a Linux host with kernel eBPF support (CAP_BPF/CAP_SYS_ADMIN) and
# bpftrace installed — NOT available on Render (ZEPH's current managed PaaS
# backend host, confirmed unable to even compile native addons). Run the
# sensor on a real Linux box you control (dev machine, a dedicated VPS, or
# the pending Serv00 migration) — never expect it to run inside the Render
# deployment itself.
#
# ZEPH_SECURITY_API_URL=https://your-zeph-backend/api/security/sensor/events
# ZEPH_SENSOR_ID=                  # stable identity, distinct from hostname/IP/PID
# ZEPH_HOST_ID=
# ZEPH_SENSOR_CREDENTIAL=          # raw credential from the one-time /sensor/register response
# ZEPH_BATCH_SIZE=50
# ZEPH_BATCH_INTERVAL_MS=5000
# ZEPH_MAX_BUFFER_SIZE=5000        # bounded local buffer — oldest events drop, not unbounded growth, once full
# ZEPH_EVENT_RATE_LIMIT=200        # sensor's own self-throttle, independent of the backend's sensorRateLimit
# ZEPH_LOG_LEVEL=info

# ── Network Intelligence (Phase 5, optional, backend side) ──────────────
# Governs the BACKEND-side detection engine (services/networkIntel/) that
# evaluates NETWORK_FLOW/DNS_QUERY events submitted through the SAME sensor
# ingestion endpoint/credential Phase 4 already uses — no new sensor
# credential system (spec section 34). The network-sensor process itself
# (ebpf-sensor/, extending ebpf-sensor/) reads NETWORK_MAX_BUFFER_SIZE/
# NETWORK_EVENT_RATE_LIMIT from ITS OWN environment, same split as the eBPF
# sensor's ZEPH_* vars above — the backend never touches those two directly.
NETWORK_SENSOR_ENABLED=true
NETWORK_FLOW_WINDOW_MS=60000
NETWORK_MAX_EVENTS_PER_BATCH=500
NETWORK_MAX_BUFFER_SIZE=5000
NETWORK_EVENT_RATE_LIMIT=200
NETWORK_DNS_ANALYSIS_ENABLED=true
# OFF and NOT implemented this phase — see ebpf-sensor/README.md. The
# flag exists now so a future phase adding TLS SNI metadata doesn't need a
# new config key, but setting this true today has no effect.
NETWORK_TLS_METADATA_ENABLED=false
NETWORK_BASELINE_ENABLED=true
# Comma-separated destinationIp or destinationIp:port entries — MongoDB,
# Redis, Cloudflare, Brevo, R2, or whatever this deployment's real
# infrastructure is (spec section 41). Empty by default: every destination
# looks "new" until configured. Example:
# NETWORK_BASELINE_TRUSTED=203.0.113.10,203.0.113.11:6379
NETWORK_BASELINE_TRUSTED=
NETWORK_SCAN_THRESHOLD=15
NETWORK_BEACON_THRESHOLD=5
NETWORK_EXFIL_THRESHOLD=52428800
