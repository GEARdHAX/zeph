# ============================================================
# Chitcx Frontend — Environment Variables (Vite)
# Copy this file to .env and fill in your values.
# All variables must be prefixed VITE_ to be exposed to the browser.
# Never commit .env to git.
# ============================================================

# ── App Identity ─────────────────────────────────────────────
# Shown in browser tab title
VITE_SITE_TITLE=zeph

# Shown in the UI branding area
VITE_SITE_BRAND=zeph

# ── Backend Connection ────────────────────────────────────────
# URL of the running backend server.
# Local dev (without Docker): http://localhost:4002
# Local Docker:               http://localhost:4002
# Production:                 https://api.yourdomain.com
VITE_BACKEND_URL=http://localhost:4002

# ── Feature Flags ────────────────────────────────────────────
# Demo mode: disables profile editing endpoints when true.
# Leave false for a real installation.
VITE_DEMO=false

# Show version/build info in the UI footer
VITE_SHOW_CREDITS=true
